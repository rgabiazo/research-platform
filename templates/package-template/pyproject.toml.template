
[build-system]
requires = ["setuptools>=69", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "research-your-package"
version = "0.1.0"
description = "Describe the reusable package boundary."
readme = "README.md"
requires-python = ">=3.11"
dependencies = []

[tool.setuptools.package-dir]
"" = "src"

[tool.setuptools.packages.find]
where = ["src"]
include = ["research_platform*"]
namespaces = true
